use std::str::FromStr;
use crate::ast::{Expression, Expr, OpCode, UnCode, ExpressionTransform, contains_filter_property};
use crate::lexer::Token;

grammar<'input>();

extern {
    type Location = usize;
    type Error = crate::lexer::LexError;

    enum Token<'input> {
        // Literals
        Number => Token::Number(<f64>),
        DoubleQuotedString => Token::DoubleQuotedString(<&'input str>),
        SingleQuotedString => Token::SingleQuotedString(<&'input str>),
        Regex => Token::Regex(<&'input str>, <&'input str>),
        TrueToken => Token::Boolean(true),
        FalseToken => Token::Boolean(false),
        Null => Token::Null,
        Identifier => Token::Identifier(<&'input str>),

        // Keywords
        "if" => Token::If,
        "else" => Token::Else,
        "in" => Token::In,
        "$now" => Token::DollarNow,
        "$now_utc" => Token::DollarNowUtc,

        // Operators
        "+" => Token::Plus,
        "-" => Token::Minus,
        "*" => Token::Multiply,
        "/" => Token::Divide,
        "//" => Token::FloorDivide,
        "%" => Token::Modulus,
        "^" => Token::Exponent,
        "!" => Token::Not,
        "~" => Token::Matches,
        "@" => Token::Capture,
        "@+" => Token::CaptureMultiple,

        // Comparison
        "==" => Token::Equal,
        "!=" => Token::NotEqual,
        ">" => Token::Greater,
        "<" => Token::Less,
        ">=" => Token::GreaterEqual,
        "<=" => Token::LessEqual,

        // Logical
        "&&" => Token::And,
        "||" => Token::Or,

        // Delimiters
        "(" => Token::LeftParen,
        ")" => Token::RightParen,
        "[" => Token::LeftBracket,
        "]" => Token::RightBracket,
        "{" => Token::LeftBrace,
        "}" => Token::RightBrace,
        "," => Token::Comma,
        ":" => Token::Colon,
        "." => Token::Dot,
        "|" => Token::Pipe,
        "?" => Token::Question,
    }
}

pub Expression: Box<Expression> = {
    ExprConditional
};

/* ---------------- LOWEST PRECEDENCE ---------------- */

ExprConditional: Box<Expression> = {
    <l:@L> <cond: ExprOr> "?" <truthy: ExprConditional> ":" <falsy: ExprConditional> <r:@R>
        => Box::new(Expression {
            expression: Expr::Conditional { left: cond, truthy, falsy },
            location: (l, r)
        }),
    ExprIfElse
};

ExprIfElse: Box<Expression> = {
    <l:@L> "if" <cond: ExprIfElse> "{" <truthy: ExprConditional> "}" "else" "{" <falsy: ExprConditional> "}" <r:@R>
        => Box::new(Expression {
            expression: Expr::Conditional { left: cond, truthy, falsy },
            location: (l, r)
        }),
    ExprOr
};

/* ---------------- LOGICAL ---------------- */

ExprOr: Box<Expression> = {
    <l:@L> <left: ExprOr> "||" <right: ExprAnd> <r:@R>
        => Box::new(Expression {
            expression: Expr::BinaryOperation { left, right, operation: OpCode::Or },
            location: (l, r)
        }),
    ExprAnd
};

ExprAnd: Box<Expression> = {
    <l:@L> <left: ExprAnd> "&&" <right: ExprComparison> <r:@R>
        => Box::new(Expression {
            expression: Expr::BinaryOperation { left, right, operation: OpCode::And },
            location: (l, r)
        }),
    ExprComparison
};

/* ---------------- COMPARISON ---------------- */

ExprComparison: Box<Expression> = {
    <l:@L> <left: ExprComparison> <op: Op20> <right: ExprAddSub> <r:@R>
        => Box::new(Expression {
            expression: Expr::BinaryOperation { left, right, operation: op },
            location: (l, r)
        }),
    ExprAddSub
};

/* ---------------- ADD / SUB ---------------- */

ExprAddSub: Box<Expression> = {
    <l:@L> <left: ExprAddSub> <op: Op30> <right: ExprMulDiv> <r:@R>
        => Box::new(Expression {
            expression: Expr::BinaryOperation { left, right, operation: op },
            location: (l, r)
        }),
    ExprMulDiv
};

/* ---------------- EXPONENT ---------------- */

ExprExponent: Box<Expression> = {
    <l:@L> <left: ExprUnary> "^" <right: ExprExponent> <r:@R>
        => Box::new(Expression {
            expression: Expr::BinaryOperation {
                left,
                right,
                operation: OpCode::Exponent,
            },
            location: (l, r)
        }),
    ExprUnary
};

/* ---------------- MULTIPLICATIVE ---------------- */

ExprMulDiv: Box<Expression> = {
    <l:@L> <left: ExprMulDiv> <op: Op40> <right: ExprUnary> <r:@R>
        => Box::new(Expression {
            expression: Expr::BinaryOperation { left, right, operation: op },
            location: (l, r)
        }),
    ExprExponent
};

/* ---------------- UNARY ---------------- */

ExprUnary: Box<Expression> = {
    <l:@L> <op: Un10> <expr: ExprUnary> <r:@R>
        => Box::new(Expression {
            expression: Expr::UnaryOperation { right: expr, operation: op },
            location: (l, r)
        }),
    ExprPipe
};

PipeArgs: Vec<Box<Expression>> = {
    <Comma<Expression>> => <>
};

/* ---------------- PIPES / TRANSFORMS ---------------- */

ExprPipe: Box<Expression> = {
    <l:@L> <subject: ExprPipe> "|" <name: Ident> <r:@R> => {
        Box::new(Expression {
            expression: Expr::Transform { name, subject, args: None },
            location: (l, r)
        })
    },

    <l:@L> <subject: ExprPipe> "|" <name: Ident> "(" <content: PipeArgs> ")" <r:@R> =>? {
         let name_str = name.as_str();

        match name_str {
            "reduce" => {
                // reduce(init, expression) - expects exactly 2 args
                if content.len() == 2 {
                    Ok(Box::new(Expression {
                        expression: Expr::ReduceExpression {
                            subject,
                            init: content[0].clone(),
                            expression: content[1].clone()
                        },
                        location: (l, r)
                    }))
                } else {
                    Err(lalrpop_util::ParseError::User {
                        error: crate::lexer::LexError { message: "Parse error".to_string(), line: 0, column: l }
                    })
                }
            },
            "map" | "filter" | "sortBy" | "any" | "all" | "find" | "findIndex" | "apply" => {
                // If the first argument is a bare identifier,
                // treat it as the shorthand for the corresponding *Transform variant
                // (e.g. `map(lowercase)` => `mapTransform(lowercase)`).
                if let Some(first) = content.first() {
                    if name_str == "map" {
                        if let Expr::Identifier(inner_name) = &first.expression {
                            let args = if content.len() > 1 { Some(content[1..].to_vec()) } else { None };
                            return Ok(Box::new(Expression {
                                expression: Expr::MapTransform { name: inner_name.clone(), subject, args },
                                location: (l, r)
                            }));
                        }
                    } else if name_str == "filter" {
                        if let Expr::Identifier(inner_name) = &first.expression {
                            let args = if content.len() > 1 { Some(content[1..].to_vec()) } else { None };
                            return Ok(Box::new(Expression {
                                expression: Expr::FilterTransform { name: inner_name.clone(), subject, args },
                                location: (l, r)
                            }));
                        }
                    } else if name_str == "sortBy" {
                        if let Expr::Identifier(inner_name) = &first.expression {
                            let args = if content.len() > 1 { Some(content[1..].to_vec()) } else { None };
                            return Ok(Box::new(Expression {
                                expression: Expr::SortByTransform { name: inner_name.clone(), subject, args },
                                location: (l, r)
                            }));
                        }
                    } else if name_str == "any" {
                        if let Expr::Identifier(inner_name) = &first.expression {
                            let args = if content.len() > 1 { Some(content[1..].to_vec()) } else { None };
                            return Ok(Box::new(Expression {
                                expression: Expr::AnyTransform { name: inner_name.clone(), subject, args },
                                location: (l, r)
                            }));
                        }
                    } else if name_str == "all" {
                        if let Expr::Identifier(inner_name) = &first.expression {
                            let args = if content.len() > 1 { Some(content[1..].to_vec()) } else { None };
                            return Ok(Box::new(Expression {
                                expression: Expr::AllTransform { name: inner_name.clone(), subject, args },
                                location: (l, r)
                            }));
                        }
                    } else if name_str == "find" {
                        if let Expr::Identifier(inner_name) = &first.expression {
                            let args = if content.len() > 1 { Some(content[1..].to_vec()) } else { None };
                            return Ok(Box::new(Expression {
                                expression: Expr::FindTransform { name: inner_name.clone(), subject, args },
                                location: (l, r)
                            }));
                        }
                    } else if name_str == "findIndex" {
                        if let Expr::Identifier(inner_name) = &first.expression {
                            let args = if content.len() > 1 { Some(content[1..].to_vec()) } else { None };
                            return Ok(Box::new(Expression {
                                expression: Expr::FindIndexTransform { name: inner_name.clone(), subject, args },
                                location: (l, r)
                            }));
                        }
                    }
                }

                // Expression transforms: expect 1 expression, optionally followed by a number
                let et = match name_str {
                    "map" => ExpressionTransform::Map,
                    "filter" => ExpressionTransform::Filter,
                    "sortBy" => ExpressionTransform::SortBy,
                    "any" => ExpressionTransform::Any,
                    "all" => ExpressionTransform::All,
                    "find" => ExpressionTransform::Find,
                    "findIndex" => ExpressionTransform::FindIndex,
                    "apply" => ExpressionTransform::Apply,
                    _ => unreachable!(),
                };

                if content.is_empty() {
                    return Err(lalrpop_util::ParseError::User {
                        error: crate::lexer::LexError { message: "Parse error".to_string(), line: 0, column: l }
                    });
                }

                let expression = content[0].clone();
                let args = if content.len() > 1 {
                    match content[1].expression {
                        Expr::Number(n) => Some(n),
                        Expr::UnaryOperation { operation: crate::ast::UnCode::Minus, ref right } => {
                            if let Expr::Number(n) = right.expression {
                                Some(-n)
                            } else {
                                return Err(lalrpop_util::ParseError::User {
                                    error: crate::lexer::LexError { message: "Parse error".to_string(), line: 0, column: l }
                                });
                            }
                        },
                        _ => {
                            return Err(lalrpop_util::ParseError::User {
                                error: crate::lexer::LexError { message: "Parse error".to_string(), line: 0, column: l }
                            });
                        }
                    }
                } else {
                    None
                };

                Ok(Box::new(Expression {
                    expression: Expr::ExpressionTransform {
                        name: et,
                        subject,
                        expression,
                        args
                    },
                    location: (l, r)
                }))
            },
            _ => {
                // Regular transform with args
                Ok(Box::new(Expression {
                    expression: Expr::Transform {
                        name,
                        subject,
                        args: Some(content)
                    },
                    location: (l, r)
                }))
            }
        }
    },

    ExprNow
};

/* ---------------- POSTFIX ---------------- */

ExprNow: Box<Expression> = {
    <l:@L> "$now" <r:@R>
        => Box::new(Expression { expression: Expr::Now, location: (l, r) }),
    <l:@L> "$now_utc" <r:@R>
        => Box::new(Expression { expression: Expr::NowUtc, location: (l, r) }),
    ExprPostfix
};

ExprPostfix: Box<Expression> = {
    <l:@L> <subject: ExprPostfix> <index: Index> <r:@R>
        => {
            let is_filter = contains_filter_property(&index);
            Box::new(Expression {
                expression: Expr::IndexOperation { subject, index, is_filter },
                location: (l, r)
            })
        },

    <l:@L> <subject: ExprPostfix> "." <ident: Ident> <r:@R>
        => Box::new(Expression {
            expression: Expr::DotOperation { subject, ident },
            location: (l, r)
        }),

    ExprAtom
};

/* ---------------- ATOMS ---------------- */

ExprAtom: Box<Expression> = {
    <l:@L> "." <ident: Ident> <r:@R>
        => Box::new(Expression {
            expression: Expr::FilterItemProperty(ident),
            location: (l, r)
        }),

    <l:@L> <e:Num> <r:@R>
        => Box::new(Expression { expression: Expr::Number(e), location: (l, r) }),

    <l:@L> <e:Bool> <r:@R>
        => Box::new(Expression { expression: Expr::Boolean(e), location: (l, r) }),

    <l:@L> <e:Str> <r:@R>
        => Box::new(Expression { expression: Expr::String(e), location: (l, r) }),

    <l:@L> <e:Array> <r:@R>
        => Box::new(Expression { expression: Expr::Array(e), location: (l, r) }),

    <l:@L> <e:Object> <r:@R>
        => Box::new(Expression { expression: Expr::Object(e), location: (l, r) }),

    <l:@L> <e:Ident> <r:@R>
        => Box::new(Expression { expression: Expr::Identifier(e), location: (l, r) }),

    <l:@L> <e:Rgx> <r:@R>
        => Box::new(Expression { expression: Expr::Regex(e.0, e.1), location: (l, r) }),

    <l:@L> Null <r:@R>
        => Box::new(Expression { expression: Expr::Null, location: (l, r) }),

    "(" <Expression> ")"
};

Un10: UnCode = {
    "!" => UnCode::Not,
    "-" => UnCode::Minus,
    "+" => UnCode::Plus,
}

Op10: OpCode = {
    "&&" => OpCode::And,
    "||" => OpCode::Or,
};

Op20: OpCode = {
    "==" => OpCode::Equal,
    "!=" => OpCode::NotEqual,
    ">=" => OpCode::GreaterEqual,
    "<=" => OpCode::LessEqual,
    ">" => OpCode::Greater,
    "<" => OpCode::Less,
    "in" => OpCode::In,
    "~" => OpCode::Matches,
    "@" => OpCode::Capture,
    "@+" => OpCode::CaptureMultiple,
};

Op30: OpCode = {
    "+" => OpCode::Add,
    "-" => OpCode::Subtract,
};

Op40: OpCode = {
    "*" => OpCode::Multiply,
    "//" => OpCode::FloorDivide,
    "/" => OpCode::Divide,
    "%" => OpCode::Modulus,
};

Op50: OpCode = {
    "%" => OpCode::Modulus,
    "^" => OpCode::Exponent,
};

Num: f64 = {
    <n:Number> => n,
};

Str: String = {
    <s:DoubleQuotedString> => if s.contains("\\\"") { s.replace("\\\"", "\"") } else { s.to_string() },
    <s:SingleQuotedString> => if s.contains("\\'") { s.replace("\\'", "'") } else { s.to_string() },
};

Rgx: (String, String) = {
    <r:Regex> => (r.0.to_string(), r.1.to_string()),
}

Ident: String = {
    <i:Identifier> => i.to_string(),
}

Index: Box<Expression> = {
    "[" <Expression> "]",
}

Bool: bool = {
    TrueToken => true,
    FalseToken => false,
}

Comma<T>: Vec<T> = {
    <v: (<T> ",")*> <e:T?> => match e {
        None => v,
        Some(e) => {
            let mut v = v;
            v.push(e);
            v
        }
    }
};

Array: Vec<Box<Expression>> = {
    "[" <Comma<Expression>> "]"
}

Object: Vec<(String, Box<Expression>)> = {
    "{" <Comma<(<ObjectIdentifier> ":" <Expression>)>> "}",
}

ObjectIdentifier: String = {
    Str,
    Ident
}
